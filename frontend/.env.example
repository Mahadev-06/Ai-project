# ClaimLens Frontend Environment Variables
# In local development, the Vite proxy directs /api to http://localhost:8000
# For production on Vercel, set VITE_API_URL to your deployed backend URL:
# Example: VITE_API_URL=https://your-backend-app.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
