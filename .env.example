# === ClaimLens Environment Configuration ===
# Copy this file to .env and fill in values as needed.

# --- Evidence Mode ---
# Default evidence mode: "local" (no API keys needed) or "live" (requires search API key)
DEFAULT_EVIDENCE_MODE=local

# --- API Keys (Optional — only needed for live web mode) ---
# Brave Search API key (get from https://api.search.brave.com/)
# Free tier: ~1000 queries/month (credit card required for account)
BRAVE_API_KEY=

# Google Fact Check Tools API key (get from Google Cloud Console)
# Free: 240 requests/minute, no billing required
GOOGLE_FACTCHECK_API_KEY=

# --- Backend Configuration ---
# Database URL (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./claimlens.db

# Corpus directory (relative to backend/)
CORPUS_DIR=data/corpus

# Model cache directory
MODEL_CACHE_DIR=.model_cache

# --- Processing Limits ---
MAX_INPUT_CHARS=10000
MAX_CLAIMS_PER_ANALYSIS=6
MAX_EVIDENCE_PER_CLAIM=5
MAX_SEARCH_QUERIES_PER_CLAIM=2
MAX_FETCHED_PAGES=10

# --- Job Management ---
JOB_TIMEOUT_SECONDS=300
JOB_RETENTION_HOURS=24

# --- CORS ---
# Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Models (pinned identifiers) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# --- Decision Policy Thresholds (provisional) ---
ENTAILMENT_THRESHOLD=0.65
CONTRADICTION_THRESHOLD=0.65
MIN_RELEVANCE_SCORE=0.25

# --- Frontend (set in frontend/.env if needed) ---
# VITE_API_URL=http://localhost:8000
